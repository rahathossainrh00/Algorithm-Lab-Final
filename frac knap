#include<bits/stdc++.h>
using namespace std;

struct Item {
    int weight, value;
    double ratio; // value per unit weight
};

bool compareByRatio(Item a, Item b) {
    return a.ratio > b.ratio; // highest value-per-weight first
}

double fractionalKnapsack(vector<Item> &items, int capacity) {
    sort(items.begin(), items.end(), compareByRatio);

    double total_value = 0.0;

    for (auto &item : items) {
        if (capacity == 0) break;

        if (item.weight <= capacity) {
            // take the whole item
            total_value += item.value;
            capacity -= item.weight;
        } else {
            // take only the fraction that fits
            total_value += item.ratio * capacity;
            capacity = 0;
        }
    }

    return total_value;
}

int main() {
    int n, capacity;
    cin >> n;

    vector<Item> items(n);
    for (int i = 0; i < n; i++) {
        cin >> items[i].weight >> items[i].value;
        items[i].ratio = (double)items[i].value / items[i].weight;
    }

    cin >> capacity;

    cout << fractionalKnapsack(items, capacity);

    return 0;
}
