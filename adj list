#include<bits/stdc++.h>
using namespace std;

int main() {
    int n, edges;
    cin >> n >> edges;

    vector<vector<int>> adj(n+1); // 1-indexed nodes

    for (int i = 0; i < edges; i++) {
        int u, v;
        cin >> u >> v;
        adj[u].push_back(v);
        adj[v].push_back(u); // remove this line if the graph is directed
    }

    // print each node's neighbors
    for (int i = 1; i <= n; i++) {
        cout << i << ": ";
        for (int neighbor : adj[i])
            cout << neighbor << " ";
        cout << endl;
    }

    return 0;
}
