#include<bits/stdc++.h>
using namespace std;

#define mx 1000
int dp[mx][mx];

int minCoins(int coins[], int n, int target_amount)
{
    if (target_amount == 0) return 0;
    if (target_amount < 0 || n == 0) return 1e9;

    if (dp[n][target_amount] == -1)
        dp[n][target_amount] = min(
            minCoins(coins, n, target_amount - coins[n-1]) + 1,
            minCoins(coins, n-1, target_amount));

    return dp[n][target_amount];
}

int main()
{
    int n;
    cin >> n;

    int coins[mx];
    for (int i = 0; i < n; i++)
        cin >> coins[i];

    int target_amount;
    cin >> target_amount;

    memset(dp, -1, sizeof(dp));

    cout << minCoins(coins, n, target_amount) << endl;

    return 0;
}
