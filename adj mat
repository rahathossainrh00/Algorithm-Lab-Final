#include<bits/stdc++.h>
using namespace std;

int main() {
    int n, edges;
    cin >> n >> edges; // n = number of nodes, edges = number of edges

    vector<vector<int>> adj(n+1, vector<int>(n+1, 0)); // 1-indexed nodes

    for (int i = 0; i < edges; i++) {
        int u, v;
        cin >> u >> v;
        adj[u][v] = 1;
        adj[v][u] = 1; // remove this line if the graph is directed
    }

    // print the matrix
    for (int i = 1; i <= n; i++) {
        for (int j = 1; j <= n; j++)
            cout << adj[i][j] << " ";
        cout << endl;
    }

    return 0;
}
