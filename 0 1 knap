#include<bits/stdc++.h>
using namespace std;

#define mx 1000
int dp[mx][mx];

int knapsack(int weight[], int value[], int n, int capacity){
    if (n == 0 || capacity == 0) return 0;

    if (dp[n][capacity] != -1) return dp[n][capacity];

    // if this item is too heavy to even consider, skip it
    if (weight[n-1] > capacity)
        dp[n][capacity] = knapsack(weight, value, n-1, capacity);
    else
        dp[n][capacity] = max(
            value[n-1] + knapsack(weight, value, n-1, capacity - weight[n-1]), // take it
            knapsack(weight, value, n-1, capacity)                             // skip it
        );

    return dp[n][capacity];
}

int main() {
    int n, capacity;
    cin >> n;

    int weight[mx], value[mx];
    for (int i = 0; i < n; i++) cin >> weight[i];
    for (int i = 0; i < n; i++) cin >> value[i];

    cin >> capacity;

    memset(dp, -1, sizeof(dp));
    cout << knapsack(weight, value, n, capacity);

    return 0;
}
